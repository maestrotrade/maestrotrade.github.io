# ============================================================
# NDAX SHARED CONFIG - M5 V3.6 + M1 V4.2
# ============================================================
# BOTH BOTS READ THIS SAME .env FILE.
# Keep credentials local. Never paste them into chat.

# ----------------------------
# SHARED ACCOUNT / CREDENTIALS
# ----------------------------
NDAX_API_KEY=add api key here
NDAX_API_SECRET=add api secret here
NDAX_USER_ID=add user id here
NDAX_ACCOUNT_ID=

NDAX_SYMBOLS=BTC/CAD,ETH/CAD,SOL/CAD,LINK/CAD

# One live position across BOTH bots combined.
SHARED_POSITION_LOCK_FILE=C:\NDAX_BOT\ndax_shared_position.lock

# One compact line per CLOSED M1/M5 trade only:
SHARED_TRADE_LOG_FILE=C:\NDAX_BOT\log.txt

# ============================================================
# M5 BOT SETTINGS
# ============================================================
M5_RISK_CAD=2.50
M5_RR_RATIO=2.0
M5_PAPER_CAD_BALANCE=500.00
M5_MAX_POSITION_CAD=100.00
M5_MAX_OPEN_POSITIONS=1

M5_MIN_CAD_RESERVE=50.00
M5_MAX_TRADES_PER_UTC_DAY=3
M5_MAX_DAILY_LOSS_CAD=5

M5_POLL_SECONDS=15
M5_HEARTBEAT_SECONDS=60
M5_CANDLE_CLOSE_GRACE_SECONDS=3

M5_MIN_ADX=18.0
M5_BUY_RSI_MIN=52.0
M5_BUY_RSI_MAX=70.0
M5_SELL_RSI_MIN=30.0
M5_SELL_RSI_MAX=48.0
M5_MIN_EMA_SEPARATION_ATR=0.07
M5_MIN_BAND_WIDTH_ATR=1.20
M5_VOL_RATIO_THRESH=0.0
M5_MAX_SIGNAL_BODY_ATR=1.70

M5_ATR_STOP_MULTIPLIER=1.50
M5_MIN_STOP_PCT=0.35
M5_MAX_STOP_ATR=4.0

M5_MAX_SPREAD_BPS_DEFAULT=50.0
M5_MAX_SPREAD_BPS_BTC_CAD=50.0
M5_MAX_SPREAD_BPS_ETH_CAD=60.0
M5_MAX_SPREAD_BPS_SOL_CAD=100.0
M5_MAX_SPREAD_BPS_LINK_CAD=90.0

M5_ESTIMATED_TAKER_FEE_PCT=0.20
M5_PROTECTIVE_SELL_BUFFER_PCT=0.40
M5_COOLDOWN_BARS_AFTER_CLOSE=2

M5_STATE_FILE=ndax_crypto_m5_shared_state.json
M5_LOG_FILE=C:\NDAX_BOT\m5_log.txt

# ============================================================
# M1 BOT SETTINGS
# ============================================================
# Start M1 in PAPER mode first.
M1_RISK_CAD=2.50
M1_RR_RATIO=1.5
M1_PAPER_CAD_BALANCE=500.00
M1_MAX_POSITION_CAD=100.00
M1_MAX_OPEN_POSITIONS=1

M1_MIN_CAD_RESERVE=50.00
M1_MAX_TRADES_PER_UTC_DAY=5
M1_MAX_DAILY_LOSS_CAD=5

M1_POLL_SECONDS=5
M1_HEARTBEAT_SECONDS=60
M1_CANDLE_CLOSE_GRACE_SECONDS=2

M1_MIN_ADX=18.0
M1_BUY_RSI_MIN=53.0
M1_BUY_RSI_MAX=68.0
M1_SELL_RSI_MIN=32.0
M1_SELL_RSI_MAX=47.0
M1_MIN_EMA_SEPARATION_ATR=0.05
M1_MIN_BAND_WIDTH_ATR=1.00
M1_VOL_RATIO_THRESH=0.0
M1_MAX_SIGNAL_BODY_ATR=1.50

M1_USE_M5_TREND_FILTER=true
M1_REQUIRE_M5_EMA_SLOPE=true
M1_M5_MIN_EMA_SEPARATION_ATR=0.05

M1_ATR_STOP_MULTIPLIER=1.25
M1_MIN_STOP_PCT=0.18
M1_MAX_STOP_ATR=5.0
M1_MAX_TARGET_MOVE_PCT=1.75

M1_MAX_SPREAD_BPS_DEFAULT=45.0
M1_MAX_SPREAD_BPS_BTC_CAD=45.0
M1_MAX_SPREAD_BPS_ETH_CAD=55.0
M1_MAX_SPREAD_BPS_SOL_CAD=85.0
M1_MAX_SPREAD_BPS_LINK_CAD=80.0

M1_ESTIMATED_TAKER_FEE_PCT=0.20
M1_PROTECTIVE_SELL_BUFFER_PCT=0.40
M1_COOLDOWN_BARS_AFTER_CLOSE=3

M1_STATE_FILE=ndax_crypto_m1_shared_state.json
M1_LOG_FILE=C:\NDAX_BOT\m1_log.txt

# ============================================================
# LIVE / PAPER MODE
# ============================================================
# IMPORTANT:
# LIVE_TRADING and LIVE_ARM are shared by BOTH bots.
#
# For safe testing, leave false:
#LIVE_TRADING=false
#LIVE_ARM=
#
# When BOTH bots have been validated and you intentionally want them live:
LIVE_TRADING=true
LIVE_ARM=YES_REAL_ORDERS
#
# The shared lock still permits only ONE open position across M1 + M5.
